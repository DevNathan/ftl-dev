{
  "name": "ftl-dev-language-server",
  "version": "0.1.0",
  "private": true,
  "description": "FreeMarker language server (monorepo / contributor tooling; not npm-published)",
  "license": "Apache-2.0",
  "bin": {
    "ftl-dev-ls": "./out/server/src/cli.js"
