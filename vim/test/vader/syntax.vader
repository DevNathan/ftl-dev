" coverage: syntax.current_syntax
" coverage: syntax.guard
Execute (syntax sets b:current_syntax and guards reload):
  new
  setfiletype freemarker
  AssertEqual b:current_syntax, 'freemarker'
  runtime syntax/freemarker.vim
  AssertEqual b:current_syntax, 'freemarker'
  bwipe!

" coverage: syntax.comment_angle
Execute (angle comment is Comment group):
  new
  setfiletype freemarker
  call setline(1, '<#-- hello -->')
  normal! 1G05l
  let name = synIDattr(synID(line('.'), col('.'), 1), 'name')
  Assert name =~? 'ftlComment\|Comment'
  bwipe!

" coverage: syntax.comment_square
Execute (square comment is Comment group):
  new
  setfiletype freemarker
  call setline(1, '[#-- hello --]')
  normal! 1G05l
  let name = synIDattr(synID(line('.'), col('.'), 1), 'name')
  Assert name =~? 'ftlComment\|Comment'
  bwipe!

" coverage: syntax.directive_if
Execute (<#if keyword is ftlDirKeyword):
  new
  setfiletype freemarker
  call setline(1, '<#if x>')
  let col = stridx(getline(1), 'if') + 1
  AssertEqual synIDattr(synID(1, col, 1), 'name'), 'ftlDirKeyword'
  bwipe!

" coverage: syntax.interpolation
Execute (${ body identifier):
  new
  setfiletype freemarker
  call setline(1, '${user}')
  let col = stridx(getline(1), 'user') + 1
  AssertEqual synIDattr(synID(1, col, 1), 'name'), 'ftlIdentifier'
  bwipe!

" coverage: syntax.user_directive
Execute (<@macro name is ftlUserName):
  new
  setfiletype freemarker
  call setline(1, '<@banner>')
  let col = stridx(getline(1), 'banner') + 1
  AssertEqual synIDattr(synID(1, col, 1), 'name'), 'ftlUserName'
  bwipe!

" coverage: syntax.builtin
Execute (?string builtin is full name not just ?s):
  new
  setfiletype freemarker
  call setline(1, '<#assign x = m1.now()?string("y")/>')
  let qcol = stridx(getline(1), '?') + 1
  AssertEqual synIDattr(synID(1, qcol, 1), 'name'), 'ftlBuiltin'
  " last letter of string in ?string
  let scol = stridx(getline(1), '?string') + strlen('?string')
  AssertEqual synIDattr(synID(1, scol, 1), 'name'), 'ftlBuiltin'
  bwipe!

" coverage: syntax.method
" coverage: syntax.directive_uniform
Execute (#assign / var / .method are three groups):
  new
  setfiletype freemarker
  call setline(1, '<#assign ymd = m1.now()?string("y")/>')
  let kcol = stridx(getline(1), 'assign') + 1
  AssertEqual synIDattr(synID(1, kcol, 1), 'name'), 'ftlDirKeyword'
  let ycol = stridx(getline(1), 'ymd') + 1
  AssertEqual synIDattr(synID(1, ycol, 1), 'name'), 'ftlIdentifier'
  let mcol = stridx(getline(1), 'm1') + 1
  AssertEqual synIDattr(synID(1, mcol, 1), 'name'), 'ftlIdentifier'
  let dcol = stridx(getline(1), '.now') + 1
  AssertEqual synIDattr(synID(1, dcol, 1), 'name'), 'ftlMethod'
  bwipe!
