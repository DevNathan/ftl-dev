{
  "name": "ftl-dev",
  "displayName": "FreeMarker (ftl-dev)",
  "description": "FreeMarker (.ftl) language support for CodeOSS — scripting-oriented tooling",
  "version": "0.0.14",
  "publisher": "nathan-0910",
  "license": "Apache-2.0",
  "icon": "icons/freemarker-icon.png",
  "homepage": "https://github.com/DevNathan/ftl-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevNathan/ftl-dev.git"
  },
  "bugs": {
    "url": "https://github.com/DevNathan/ftl-dev/issues"
  },
  "qna": "https://github.com/DevNathan/ftl-dev/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "freemarker",
    "ftl",
    "template",
    "java"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "freemarker",
        "aliases": [
          "FreeMarker",
          "FTL",
          "ftl"
        ],
        "extensions": [
          ".ftl",
          ".ftlh",
          ".ftlx"
        ],
        "icon": {
          "light": "./icons/freemarker.svg",
          "dark": "./icons/freemarker.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "freemarker",
        "scopeName": "text.html.freemarker",
        "path": "./syntaxes/freemarker.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.basic": "html"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "ftl-dev-icons",
        "label": "ftl-dev (FreeMarker file icons)",
        "path": "./icons/ftl-icon-theme.json"
      }
    ],
    "configuration": {
      "title": "ftl-dev",
      "properties": {
        "ftl-dev.comparisonOperatorPresentation": {
          "type": "boolean",
          "default": false,
          "description": "Show alphabetic comparison operators (lt, lte, gt, gte) as <, <=, >, >= in the editor. Off by default (editor decorations can distort the minimap). Place the caret on a token to reveal the source text when enabled."
        }
      }
    },
    "configurationDefaults": {
      "[freemarker]": {
        "editor.autoIndent": "full"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/freemarker.tmLanguage.json -g syntaxes/test-support/text.html.basic.tmLanguage.json \"../tests/grammar/*.ftl\"",
    "test:unit": "npm run compile && node out/symbols.test.js && node out/catalog.test.js && node out/closeTag.test.js && node out/hoverImport.test.js && node out/diagnostics.test.js && node out/reference/freemarkerRef.test.js && node out/indentRules.test.js && node out/indentAlign.test.js && node out/outline.test.js && node out/references.test.js && node out/semanticTokens.test.js && node out/comparisonDisplay.test.js && node out/signatureHelp.test.js && node out/comments.test.js",
    "test": "npm run test:grammar && npm run test:unit",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies",
    "publish:ovsx": "npm run package && npx --yes ovsx publish *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}

