{
  "comments": {
    "blockComment": [
      "<#--",
      "-->"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": ["string", "comment"]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": ["string", "comment"]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": ["string", "comment"]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string", "comment"]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    },
    {
      "open": "${",
      "close": "}",
      "notIn": ["comment"]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*[\\[<][#@](?!/)\\w+",
      "end": "^\\s*[\\[<]/[#@]\\w+"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:<#(?:if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment|else|elseif|elseIf|recover|case|on|default|sep)\\b.*>\\s*|\\[#(?:if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment|else|elseif|elseIf|recover|case|on|default|sep)\\b.*\\]\\s*|<#(?:assign|local|global)(?:\\s+(?:[a-zA-Z_][\\w]*|\"[^\"]+\")(?:\\s+in\\s+[^>]*)?)?>\\s*|\\[#(?:assign|local|global)(?:\\s+(?:[a-zA-Z_][\\w]*|\"[^\"]+\")(?:\\s+in\\s+[^\\]]*)?)?\\]\\s*|<@[a-zA-Z_][\\w.]*(?!.*\\/\\s*>)(?:\\s[^>]*)?>\\s*|\\[@[a-zA-Z_][\\w.]*(?!.*\\/\\s*\\])(?:\\s[^\\]]*)?\\]\\s*)$",
    "decreaseIndentPattern": "^\\s*(?:[\\[<]#(?:else|elseif|elseIf|recover|case|on|default|sep)\\b|[\\[<]/#(?:if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment|assign|local|global)\\b|[\\[<]/@[a-zA-Z_][\\w.]*\\b)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*<#(if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment)\\b.*>\\s*$",
      "afterText": "^\\s*[\\[<]/[#@]\\w+",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*\\[#(if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment)\\b.*\\]\\s*$",
      "afterText": "^\\s*[\\[<]/[#@]\\w+",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*<#(assign|local|global)(?:\\s+(?:[a-zA-Z_][\\w]*|\"[^\"]+\")(?:\\s+in\\s+[^>]*)?)?>\\s*$",
      "afterText": "^\\s*[\\[<]/#(assign|local|global)\\b",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*<@[a-zA-Z_][\\w.]*(?!.*\\/\\s*>)(?:\\s[^>]*)?>\\s*$",
      "afterText": "^\\s*[\\[<]/@\\w+",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*<#(else|elseif|elseIf|recover|case|on|default|sep)\\b.*>\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*\\[#(else|elseif|elseIf|recover|case|on|default|sep)\\b.*\\]\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*<#(if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment)\\b.*>\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*\\[#(if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment)\\b.*\\]\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*<#(assign|local|global)(?:\\s+(?:[a-zA-Z_][\\w]*|\"[^\"]+\")(?:\\s+in\\s+[^>]*)?)?>\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*<@[a-zA-Z_][\\w.]*(?!.*\\/\\s*>)(?:\\s[^>]*)?>\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*[\\[<]/#(if|list|macro|function|attempt|compress|escape|noescape|noEscape|autoesc|autoEsc|noautoesc|noAutoEsc|transform|switch|items|foreach|forEach|comment|assign|local|global)\\b",
      "action": {
        "indent": "outdent"
      }
    },
    {
      "beforeText": "^\\s*[\\[<]/@[a-zA-Z_][\\w.]*\\b",
      "action": {
        "indent": "outdent"
      }
    }
  ]
}
