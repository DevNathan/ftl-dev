{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FreeMarker",
  "scopeName": "text.html.freemarker",
  "patterns": [
    { "include": "#comment" },
    { "include": "#directive-angle" },
    { "include": "#directive-square" },
    { "include": "#interpolation" },
    { "include": "text.html.basic" }
  ],
  "injections": {
    "L:text.html.basic - comment - string": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#directive-angle" },
        { "include": "#directive-square" },
        { "include": "#interpolation" }
      ]
    }
  },
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.freemarker",
          "comment": "Whole body is comment.block only (plus optional ftldoc). package.json tokenTypes/unbalancedBracketScopes force Comment token type so bracket-pair colorization and auto-close stay off. applyEndPatternLast for nested <#--…-->.",
          "begin": "<#--",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.freemarker" }
          },
          "end": "-->",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.freemarker" }
          },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#comment" },
            { "include": "#ftldoc-tag" }
          ]
        },
        {
          "name": "comment.block.freemarker",
          "begin": "\\[#--",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.freemarker" }
          },
          "end": "--\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.freemarker" }
          },
          "applyEndPatternLast": true,
          "patterns": [
            { "include": "#comment" },
            { "include": "#ftldoc-tag" }
          ]
        }
      ]
    },
    "ftldoc-tag": {
      "comment": "ftldoc tags inside FTL comments (plan 0038): @param {type} [name], @return(s) {type}, inline {@link|linkplain|linkcode|code|literal}, known tags anywhere, any @tag at line start (after optional whitespace / * gutter) or right after the comment opener; mid-line unknown @word and user@host stay plain comment. Nested #comment include stays first in comment patterns.",
      "patterns": [
        {
          "match": "(?i)(@param)\\b(?:\\s+(\\{[^}\\n]*[^\\s}][^}\\n]*\\}))?(?:\\s+\\[?([A-Za-z_][\\w.]*))?",
          "captures": {
            "1": { "name": "keyword.other.documentation.ftldoc.freemarker" },
            "2": { "name": "entity.name.type.ftldoc.freemarker" },
            "3": { "name": "variable.parameter.ftldoc.freemarker" }
          }
        },
        {
          "match": "(?i)(@returns?)\\b(?:\\s+(\\{[^}\\n]*[^\\s}][^}\\n]*\\}))?",
          "captures": {
            "1": { "name": "keyword.other.documentation.ftldoc.freemarker" },
            "2": { "name": "entity.name.type.ftldoc.freemarker" }
          }
        },
        {
          "match": "\\{(@(?i:link|linkplain|linkcode|code|literal))\\b",
          "captures": {
            "1": { "name": "keyword.other.documentation.ftldoc.freemarker" }
          }
        },
        {
          "match": "(?i)@(?:nodoc|deprecated|see|since|stop|example|note|remarks|todo|author|version)\\b",
          "name": "keyword.other.documentation.ftldoc.freemarker"
        },
        {
          "match": "(?:^|(?<=<#--|\\[#--))\\s*(?:\\*\\s*)?(@(?!(?i:param|returns?)\\b)[A-Za-z][\\w-]*)",
          "captures": {
            "1": { "name": "keyword.other.documentation.ftldoc.freemarker" }
          }
        }
      ]
    },
    "directive-names": {
      "match": "\\b(assign|attempt|autoesc|break|case|compress|continue|default|else|elseif|escape|fallback|flush|ftl|function|global|if|import|include|items|list|local|lt|macro|nested|noautoesc|noescape|noparse|nt|outputformat|recover|recurse|return|rt|sep|setting|stop|switch|t|transform|visit)\\b",
      "name": "keyword.control.directive.freemarker"
    },
    "directive-angle": {
      "patterns": [
        {
          "name": "meta.directive.freemarker",
          "begin": "(</?#)(assign|attempt|autoesc|break|case|compress|continue|default|else|elseif|escape|fallback|flush|ftl|function|global|if|import|include|items|list|local|lt|macro|nested|noautoesc|noescape|noparse|nt|outputformat|recover|recurse|return|rt|sep|setting|stop|switch|t|transform|visit)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.freemarker" },
            "2": { "name": "keyword.control.directive.freemarker" }
          },
          "end": "(/?)>",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.freemarker" },
            "0": { "name": "punctuation.definition.tag.end.freemarker" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#string-raw" },
            { "include": "#string-double" },
            { "include": "#string-single" },
            { "include": "#directive-named-param" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "meta.directive.user.freemarker",
          "begin": "(</?@)([a-zA-Z_][\\w\\.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.freemarker" },
            "2": { "name": "entity.name.function.freemarker" }
          },
          "end": "(/?)>",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.freemarker" },
            "0": { "name": "punctuation.definition.tag.end.freemarker" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#string-raw" },
            { "include": "#string-double" },
            { "include": "#string-single" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "meta.directive.freemarker",
          "begin": "(</?#)([a-zA-Z_][\\w\\.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.freemarker" },
            "2": { "name": "entity.name.tag.freemarker" }
          },
          "end": "(/?)>",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.freemarker" },
            "0": { "name": "punctuation.definition.tag.end.freemarker" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#string-raw" },
            { "include": "#string-double" },
            { "include": "#string-single" },
            { "include": "#expression" }
          ]
        }
      ]
    },
    "directive-square": {
      "patterns": [
        {
          "name": "meta.directive.freemarker",
          "begin": "(\\[/?#)(assign|attempt|autoesc|break|case|compress|continue|default|else|elseif|escape|fallback|flush|ftl|function|global|if|import|include|items|list|local|lt|macro|nested|noautoesc|noescape|noparse|nt|outputformat|recover|recurse|return|rt|sep|setting|stop|switch|t|transform|visit)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.freemarker" },
            "2": { "name": "keyword.control.directive.freemarker" }
          },
          "end": "(/?)\\]",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.freemarker" },
            "0": { "name": "punctuation.definition.tag.end.freemarker" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#string-raw" },
            { "include": "#string-double" },
            { "include": "#string-single" },
            { "include": "#directive-named-param" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "meta.directive.user.freemarker",
          "begin": "(\\[/?@)([a-zA-Z_][\\w\\.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.freemarker" },
            "2": { "name": "entity.name.function.freemarker" }
          },
          "end": "(/?)\\]",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.freemarker" },
            "0": { "name": "punctuation.definition.tag.end.freemarker" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#string-raw" },
            { "include": "#string-double" },
            { "include": "#string-single" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "meta.directive.freemarker",
          "begin": "(\\[/?#)([a-zA-Z_][\\w\\.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.freemarker" },
            "2": { "name": "entity.name.tag.freemarker" }
          },
          "end": "(/?)\\]",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.freemarker" },
            "0": { "name": "punctuation.definition.tag.end.freemarker" }
          },
          "patterns": [
            { "include": "#comment" },
            { "include": "#string-raw" },
            { "include": "#string-double" },
            { "include": "#string-single" },
            { "include": "#expression" }
          ]
        }
      ]
    },
    "directive-named-param": {
      "comment": "Sync with namedParamsWithAliases(DIRECTIVE_NAMED_PARAMS) in extension/src/directiveParams.ts (snake ∪ distinct camel). Lookahead (?=\\s*=[^=]) avoids matching ==.",
      "name": "entity.other.attribute-name.freemarker",
      "match": "\\b(?:encoding|strip_whitespace|stripWhitespace|strip_text|stripText|strict_syntax|strictSyntax|attributes|ns_prefixes|nsPrefixes|auto_esc|autoEsc|output_format|outputFormat|locale|number_format|numberFormat|boolean_format|booleanFormat|date_format|dateFormat|time_format|timeFormat|datetime_format|datetimeFormat|time_zone|timeZone|sql_date_and_time_time_zone|sqlDateAndTimeTimeZone|c_format|cFormat|url_escaping_charset|urlEscapingCharset|output_encoding|outputEncoding|classic_compatible|classicCompatible|parse|ignore_missing|ignoreMissing)\\b(?=\\s*=[^=])"
    },
    "interpolation": {
      "comment": "Also included inside non-raw string literals (plan 0039), JS template-literal style: meta.embedded.line resets the string color for the body and punctuation.section.embedded gives ${ } the template-expression color.",
      "name": "meta.interpolation.freemarker meta.embedded.line.freemarker",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.freemarker punctuation.section.embedded.begin.freemarker" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.freemarker punctuation.section.embedded.end.freemarker" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string-raw" },
        { "include": "#string-double" },
        { "include": "#string-single" },
        { "include": "#expression" }
      ]
    },
    "string-raw": {
      "comment": "FTL raw strings r\"…\" / r'…' (plan 0039): no escapes, no interpolation. \\b keeps identifiers ending in r unaffected.",
      "patterns": [
        {
          "name": "string.quoted.double.raw.freemarker",
          "begin": "\\br\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.raw.freemarker",
          "begin": "\\br'",
          "end": "'"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.freemarker",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.freemarker",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.freemarker",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.freemarker",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "expression": {
      "patterns": [
        {
          "name": "constant.numeric.freemarker",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "constant.language.boolean.freemarker",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.operator.existential.freemarker",
          "match": "\\?\\?"
        },
        {
          "match": "(\\?)([a-zA-Z_][\\w]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.builtin.freemarker" },
            "2": { "name": "support.function.builtin.freemarker" }
          }
        },
        {
          "name": "keyword.operator.freemarker",
          "match": "(\\.\\.\\.|\\.\\.|==|!=|<=|>=|&&|\\|\\||!|%|\\*|\\/|\\+|-|=|<|>|:)"
        },
        {
          "match": "\\b([a-zA-Z_][\\w]*)(\\.)([a-zA-Z_][\\w]*)\\s*(\\()",
          "captures": {
            "1": { "name": "variable.other.object.freemarker" },
            "2": { "name": "punctuation.accessor.freemarker" },
            "3": { "name": "entity.name.function.freemarker" },
            "4": { "name": "punctuation.definition.parameters.begin.freemarker" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][\\w]*)\\s*(\\()",
          "captures": {
            "1": { "name": "entity.name.function.freemarker" },
            "2": { "name": "punctuation.definition.parameters.begin.freemarker" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][\\w]*)(\\.)([a-zA-Z_][\\w]*)",
          "captures": {
            "1": { "name": "variable.other.object.freemarker" },
            "2": { "name": "punctuation.accessor.freemarker" },
            "3": { "name": "variable.other.property.freemarker" }
          }
        },
        {
          "name": "variable.other.freemarker",
          "match": "\\b[a-zA-Z_][\\w]*\\b"
        }
      ]
    }
  }
}
